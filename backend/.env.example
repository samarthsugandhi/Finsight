# Copy this file to .env and fill in real values:
#   cp .env.example .env

# --- Database ---
DATABASE_URL="mysql://user:password@localhost:3306/finsight"

# --- Auth ---
# Generate long random strings for both, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- AI (Ollama, local) ---
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b

# --- Market data (Portfolio module) ---
# Uses Twelve Data (https://twelvedata.com) for STOCK and CRYPTO prices only.
# MUTUAL_FUND and GOLD holdings are priced manually — Twelve Data doesn't
# cover Indian mutual fund NAV or gold-per-gram pricing, and this project
# deliberately avoids adding a second external provider just for those.
#
# MARKET_API_KEY is OPTIONAL. If left blank, the market data refresh loop
# simply never runs — every STOCK/CRYPTO holding shows "market data
# unavailable" and the rest of the app (including the rest of Portfolio)
# works completely normally. Get a free key at https://twelvedata.com/pricing
MARKET_API_URL=https://api.twelvedata.com
MARKET_API_KEY=
# How often (in seconds) the backend fetches fresh prices from Twelve Data.
# Do not set this too low — Twelve Data's free tier allows 800 calls/day.
MARKET_DATA_REFRESH_SECONDS=60
